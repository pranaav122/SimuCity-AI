# SimuCity AI — Environment Variables
#
# Copy this file to .env and fill in your API keys.
# Without keys, only mock mode is available (fully functional, zero cost).
#
# Usage:
#   cp .env.example .env
#   # Edit .env with your keys
#   python -m uvicorn simucity.api.main:app --host 127.0.0.1 --port 8000

# Anthropic Claude API key (required for model='claude')
# Get one at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Google Gemini API key (required for model='gemini')
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
